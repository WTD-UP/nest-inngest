{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "security:openssf-scorecard"],
  "automergeStrategy": "rebase",
  "rebaseWhen": "behind-base-branch",
  "branchConcurrentLimit": 10,
  "prConcurrentLimit": 6,
  "minimumReleaseAge": "1 day",
  "timezone": "America/Chicago",
  "schedule": ["after 3pm and before 4pm"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "automerge": true
  },
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["after 9:00am and before 1:00pm every weekday"]
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["lockFileMaintenance"],
      "automerge": true
    },
    {
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Automerge non-major devDependencies",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Automerge patch updates for stable production deps",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": ">=1.0.0",
      "automerge": true,
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Automerge lint/format tooling",
      "matchPackageNames": ["/eslint/", "/prettier/", "/stylelint/", "/biome/"],
      "automerge": true
    },
    {
      "description": "Label major updates as breaking changes",
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "breaking-change"],
      "automerge": false
    }
  ]
}
